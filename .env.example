# Register exactly http://localhost:4387/auth/twitch/callback in Twitch developer console.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional configured Mark This reward ID. Leave empty to skip redemption scope/subscription.
TWITCH_REWARD_ID=
# Comma-separated features. Use chat,raid for initial live-chat testing with minimal scope.
TWITCH_FEATURES=chat,raid,subscriptions,cheer
# Comma-separated immutable Twitch user IDs, not display names.
TWITCH_BOT_USER_IDS=
# Local-only backend. Do not expose through a tunnel or reverse proxy.
PORT=4387
# Separate origin, with read-only routes and no controller credentials.
OVERLAY_PORT=4388
# Optional. Disabled unless explicitly enabled, with a key, Responses model and budget.
AI_CAPTIONS_ENABLED=false
OPENAI_API_KEY=
OPENAI_CAPTION_MODEL=
AI_CAPTION_SESSION_BUDGET=10
# Explicit opt-in to sending bounded, ephemeral chat samples. Default sends structured evidence only.
AI_CHAT_CONTEXT=false
